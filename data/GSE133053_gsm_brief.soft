!Sample_title = 6 h H2O_1
!Sample_geo_accession = GSM3899015
!Sample_status = Public on Jun 21 2019
!Sample_submission_date = Jun 20 2019
!Sample_last_update_date = Jun 21 2019
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = seedlings
!Sample_organism_ch1 = Arabidopsis thaliana
!Sample_taxid_ch1 = 3702
!Sample_characteristics_ch1 = ecotype: Col-0
!Sample_characteristics_ch1 = genotype: wild-type
!Sample_characteristics_ch1 = time point: 6 h
!Sample_characteristics_ch1 = agent: H2O
!Sample_treatment_protocol_ch1 = Seedlings were moved from MS medium plate to water and soak in water overnight. Water was replace with water with/without elicitor (flg22, nlp20 or C6). Samples were harvested after 1, 6, and 24 hours.
!Sample_growth_protocol_ch1 = Arabidopsis seedlings were grown on half-strength MS medium under short-day conditions (8 h light/16 h darkness, 150 μmol/cm2s white fluorescent light, 40-60 % humidity, 22 °C).
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = Total RNA was extracted using the RNeasy Plant Mini Kit (QIAGEN), and DNA contamination was removed with the RNase-Free DNase Set (QIAGEN). RNA quantity and quality were checked with an ABI 3730xl DNA Analyzer (Applied Biosystems) and a Qubit® 2.0 Fluorometer (Invitrogen). Standard protocols provided by the kits were used for extraction.
!Sample_extract_protocol_ch1 = The cDNA library was prepared from 2 μg RNA using Illumina® TruSeq® RNA Sample Preparation Kits (Illumina).  Standard protocol provided by the kits is used. For library construction.
!Sample_data_processing = RNA-seq reads were aligned to the CD-HIT optimized TAIR10 Col-0 reference transcripts using Bowtie 2.
!Sample_data_processing = Uniquely mapped reads were quantified per representative gene model using eXpress.
!Sample_data_processing = Supplementary_files_format_and_content: uniq_counts
